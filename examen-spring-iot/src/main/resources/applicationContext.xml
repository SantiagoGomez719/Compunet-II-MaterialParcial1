<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="deviceRepositoryBean"
        class="com.compunet.repository.DeviceRepositoryInMemory"/>

    <bean id="measurementRepositoryBean"
        class="com.compunet.repository.MeasurementRepositoryInMemory"/>

    <bean id="deviceServiceBean" class="com.compunet.service.DeviceServiceImpl">
        <constructor-arg ref="deviceRepositoryBean"/>
    </bean>

    <bean id="measurementServiceBean" class="com.compunet.service.MeasurementServiceImpl">
        <constructor-arg ref="deviceRepositoryBean"/>
        <constructor-arg ref="measurementRepositoryBean"/>
    </bean>

</beans>
